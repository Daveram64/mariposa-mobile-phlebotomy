{
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/homesacramento",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#closing",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#all-services",
      "permanent": true
    },
    {
      "source": "/services-1",
      "destination": "/athlete-blood-draws/",
      "permanent": true
    },
    {
      "source": "/nutrition",
      "destination": "/athlete-blood-draws/",
      "permanent": true
    },
    {
      "source": "/elite-performance-blood-testing",
      "destination": "/athlete-blood-draws/",
      "permanent": true
    },
    {
      "source": "/monarch-endur",
      "destination": "/athlete-blood-draws/",
      "permanent": true
    },
    {
      "source": "/autism-friendly",
      "destination": "/pediatric-blood-draws/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/therapeutic-phlebotomy",
      "destination": "/therapeutic-phlebotomy/",
      "permanent": true
    },
    {
      "source": "/galleri-test-blood-draw",
      "destination": "/galleri-test-blood-draw/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/llms",
      "destination": "/llms.txt",
      "permanent": true
    },
    {
      "source": "/blog/what-is-mobile-phlebotomy-a-complete-guide-for-bay-area-patients",
      "destination": "/#how-it-works",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/store/:path*",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/athlete-blood-draws",
      "destination": "/athlete-blood-draws/",
      "permanent": true
    },
    {
      "source": "/pediatric-blood-draws",
      "destination": "/pediatric-blood-draws/",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/#reviews",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#footer",
